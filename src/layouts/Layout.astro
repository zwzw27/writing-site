---
import '../styles/global.css';
import { site } from '../site';
import { href } from '../lib/writing';
interface Props { title?: string; description?: string; active?: string; }
const { title, description = site.description, active } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} — ${site.name}` : `${site.name} — Writer`}</title>
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href={href()}>{site.name}<span>Writer</span></a>
        <nav aria-label="Main navigation">
          <a href={href()} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href={href('writing/')} aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
          <a href={href('about/')} aria-current={active === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.name}</span><a href={href('writing/')}>Writing archive</a></footer>
    </div>
  </body>
</html>
