---
import Layout from '../layouts/Layout.astro';
import WritingList from '../components/WritingList.astro';
import { getWriting, href } from '../lib/writing';
import { site } from '../site';
const articles = await getWriting();
---
<Layout active="home">
  <section class="intro"><h1 class="visually-hidden">{site.name}</h1><p class="lede">{site.intro}</p><a class="text-link" href={site.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a></section>
  <section class="selected-section" aria-labelledby="selected-heading"><div class="section-heading"><h2 id="selected-heading">Selected Writing</h2><a class="text-link" href={href('writing/')}>View all writing <span aria-hidden="true">→</span></a></div><WritingList articles={articles.filter(a => a.data.featured)} selected /></section>
</Layout>
