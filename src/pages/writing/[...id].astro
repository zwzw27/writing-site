---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getWriting, href, dateLabel } from '../../lib/writing';
export async function getStaticPaths() { return (await getWriting()).map(article => ({ params: { id: article.id }, props: { article } })); }
interface Props { article: CollectionEntry<'writing'>; }
const { article } = Astro.props;
const { Content } = await render(article);
---
<Layout title={article.data.title} description={`${article.data.title}. Published in ${article.data.publication} on ${dateLabel(article.data.date)}.`} active="writing">
  <article class="article"><header class="article-heading"><a class="text-link" href={href('writing/')}><span aria-hidden="true">←</span> All writing</a><h1>{article.data.title}</h1><p class="meta"><span>{article.data.publication}</span><span aria-hidden="true">·</span><time datetime={article.data.date.toISOString().slice(0, 10)}>{dateLabel(article.data.date)}</time></p>{article.data.originalUrl && <a class="original-link" href={article.data.originalUrl}>Read the original publication <span aria-hidden="true">↗</span></a>}</header>{article.data.videoUrl && <div class="video"><iframe src={article.data.videoUrl} title={article.data.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>}<div class="prose"><Content /></div><div class="article-end"><a class="text-link" href={href('writing/')}>← Back to the archive</a></div></article>
</Layout>
